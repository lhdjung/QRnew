<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.lhdjung.QRnew</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MPL-2.0</project_license>
  <name>QRnew</name>
  <summary>Local-only QR code generator</summary>
  <description>
    <p>
      Create a QR code as you type, then save it as PNG or SVG or copy it.
      Change its colours and shape, put an image in the middle, save the look
      as a theme, and read the text back out of a QR code image. Nothing
      leaves your computer.
    </p>
  </description>
  <developer id="dev.lhdjung">
    <name>Lukas Jung</name>
  </developer>
  <icon type="stock">dev.lhdjung.QRnew</icon>
  <url type="vcs-browser">https://github.com/lhdjung/QRnew</url>
  <launchable type="desktop-id">dev.lhdjung.QRnew.desktop</launchable>
  <provides>
    <id>dev.lhdjung.QRnew</id>
    <binaries>
      <binary>qrnew</binary>
    </binaries>
  </provides>
  <requires>
    <!-- The longest edge of the display, in logical pixels, and it is the
         window's own minimum rather than a guess: `main.rs` asks winit for a
         minimum surface of 1160x700, because three columns of controls do not
         fit in less. 360 was here from the COSMIC template, and advertised
         the app to software centres at a size it cannot open at. `side`
         is spelled out because it defaults to the *shortest* edge. -->
    <display_length side="longest" compare="ge">1160</display_length>
    <display_length side="shortest" compare="ge">700</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <categories>
    <category>Utility</category>
    <category>Graphics</category>
  </categories>
  <keywords>
    <keyword>QR</keyword>
    <keyword>barcode</keyword>
    <keyword>generator</keyword>
    <keyword>offline</keyword>
  </keywords>
  <content_rating type="oars-1.1" />
</component>
